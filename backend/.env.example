# Configuración del Entorno LunaVet
PORT=3000
NODE_ENV=development

# Configuración Base de Datos MySQL (Producción cPanel)
DB_CLIENT=mysql2
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=lunavet_user
DB_PASSWORD=lunavet_password_segura
DB_NAME=lunavet_db

# Clave Maestra de Cifrado en Reposo a Nivel de Aplicación (AES-256-GCM)
# Debe ser una cadena hexadecimal de 64 caracteres (32 bytes)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Seguridad JWT
JWT_SECRET=super_secret_jwt_key_cambiar_en_produccion_1234567890
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# Secreto de Invocación para Tareas Cron de cPanel
CRON_SECRET=secreto_cron_cpanel_token_protegido_9876543210

# Secreto de Autenticación de Webhooks de Pago (MercadoPago / SPEI)
PAYMENT_WEBHOOK_SECRET=secreto_webhook_pagos_lunavet_token

# Orígenes Permitidos CORS
CORS_ORIGIN=https://lunavet.lat,https://app.lunavet.lat,http://localhost:3000,http://localhost:5173

# Límites de Almacenamiento BLOB
BLOB_MAX_FILE_SIZE_BYTES=5242880
